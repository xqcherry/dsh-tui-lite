{
  "name": "dsh-tui-lite",
  "version": "0.13.0",
  "description": "A lightweight terminal client for DeepSeek Harness agents, sessions and tools.",
  "keywords": [
    "dsh-tui-lite",
    "dsh",
    "dsh-tui",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "tui",
    "terminal",
    "cli",
    "ink",
    "agent",
    "coding-agent"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "dsl": "./bin/dsh-tui.js",
    "dsh-tui-lite": "./bin/dsh-tui.js"
  },
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./oauth": {
      "types": "./lib/types/oauth.d.ts",
      "import": "./lib/types/oauth.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_LICENSES"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "clean": "node scripts/clean-lib.mjs",
    "compile": "node scripts/clean-lib.mjs && tsc -p tsconfig.json",
    "build": "npm run compile",
    "dev": "pnpm build && pnpm start",
    "start": "node bin/dsh-tui.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "prepare": "npm run compile",
    "prepack": "pnpm build",
    "verify:package": "pnpm build && node scripts/verify-packaged-install.mjs"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "auto-bind": "^4.0.0 || ^5.0.0",
    "bidi-js": "^1.0.0",
    "chalk": "^6.0.0",
    "cli-boxes": "^3.0.0 || ^4.0.0",
    "cli-highlight": "^2.1.11",
    "code-excerpt": "^3.0.0 || ^4.0.0",
    "diff": "^8.0.4",
    "emoji-regex": "^11.0.0",
    "get-east-asian-width": "^1.0.0",
    "highlight.js": "^11.11.1",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.17.0",
    "marked": "^18.0.7",
    "react": "^19.2.0",
    "react-reconciler": "^0.34.0",
    "semver": "^7.0.0",
    "signal-exit": "^4.0.0",
    "sixel": "0.16.0",
    "stack-utils": "^2.0.0",
    "strip-ansi": "^7.0.0",
    "supports-hyperlinks": "^4.6.0",
    "type-fest": "^5.8.0",
    "wrap-ansi": "^10.0.1",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-format-catalog": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "^7.0.0",
    "@xterm/headless": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
